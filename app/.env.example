# LotVue360 local settings template. The desktop app copies this to the per-user
# data directory on first launch. Never put real secrets into Git or support tickets.

# Authentication and owner bootstrap
LOTVUE_FEATURE_AUTH=1
LOTVUE_FEATURE_PAYMENTS=0
LOTVUE_PRICING_APPROVED=0

# Pricing — the ONE place the price is set (read by app/billing.py).
# 9900 = $99/month Dealership plan. A dealer gets LOTVUE_FREE_VEHICLES vehicles
# free for the life of the account (no monthly reset); re-shooting a vehicle
# they already have never counts. Nothing is sold until the owner sets both
# LOTVUE_FEATURE_PAYMENTS=1 and LOTVUE_PRICING_APPROVED=1.
LOTVUE_PRICE_MONTHLY_CENTS=9900
LOTVUE_FREE_VEHICLES=5
# Legacy one-time credit packs / per-vehicle unlocks: off unless deliberately sold.
LOTVUE_CREDIT_PACKS=0
LOTVUE_FEATURE_WATERMARK=0
# Leave blank to create a private per-install secret automatically.
LOTVUE_JWT_SECRET=
LOTVUE_OWNER_EMAIL=
LOTVUE_OWNER_NAME=Platform Owner
LOTVUE_OWNER_PASSWORD_HASH=
# Comma-separated admin emails that may comp a plan via /api/set-plan.
LOTVUE_ADMIN_EMAILS=
# 1 = blur license plates on every newly built 360 spin before it is published.
LOTVUE_AUTO_PLATE_BLUR=0
LOTVUE_REPUTATION_DB=
LOTVUE_IMPORT_USER=
LOTVUE_PORT=8360
LOTVUE_COOKIE_SECURE=
# Optional source/developer override. Set in the process environment before
# launching a desktop build to override its per-user data-directory default;
# changing this value inside the user-data .env cannot relocate that same folder.
LOTVUE_DATA_DIR=
LOTVUE_STORAGE_DIR=

# Public URL: feed exports require the dealer's real public HTTPS hostname.
LOTVUE_PUBLIC_URL=

# Google Vehicle Listings feed. These settings enable feed generation only;
# Google account approval, URL registration, and live ingestion are separate.
LOTVUE_GOOGLE_FEED_TOKEN=
LOTVUE_GOOGLE_FEED_USER_EMAIL=
LOTVUE_GOOGLE_STORE_CODE=
LOTVUE_DEALER_NAME=
LOTVUE_DEALER_ADDR1=
LOTVUE_DEALER_CITY=
LOTVUE_DEALER_REGION=
LOTVUE_DEALER_POSTAL=
LOTVUE_DEALER_COUNTRY=US

# Optional distribution and social connectors; each needs owner/dealer credentials.
LOTVUE_FB_PAGE_ID=
LOTVUE_COMSCORE_MARKET_ID=
POSTIZ_URL=
POSTIZ_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
EBAY_APP_ID=
EBAY_CERT_ID=
EBAY_DEV_ID=
EBAY_OAUTH_TOKEN=
EBAY_SANDBOX=1
LOTVUE_FTP_HOST=
LOTVUE_FTP_PORT=21
LOTVUE_FTP_USER=
LOTVUE_FTP_PASS=
LOTVUE_FTP_DIR=/
LOTVUE_FTP_TLS=1
LOTVUE_DMS_WATCH_ROOT=
LOTVUE_IMPORT_USER=

# Optional vehicle data providers; public NHTSA/EPA routes need network access,
# while licensed services require an account and API credentials.
MARKETCHECK_API_KEY=
MARKETCHECK_HOST=https://mc-api.marketcheck.com/v2
BLACKBOOK_API_TOKEN=
BLACKBOOK_CUSTOMER_ID=
BLACKBOOK_HOST=https://service.blackbookcloud.com
AUTOCHECK_API_KEY=
AUTOCHECK_API_SECRET=
AUTOCHECK_HOST=https://api.experian.com/automotive/autocheck/v1
PLATE2VIN_API_KEY=
PLATE2VIN_HOST=https://platetovin.com/api/convert

# SMTP is not enabled until an operator supplies a working relay/account.
LOTVUE_SMTP_HOST=
LOTVUE_SMTP_PORT=587
LOTVUE_SMTP_USER=
LOTVUE_SMTP_PASS=
LOTVUE_SMTP_FROM=
LOTVUE_NOTIFY_EMAIL=

# Stripe stays off until LOTVUE_FEATURE_PAYMENTS=1 and LOTVUE_PRICING_APPROVED=1.
# Webhook endpoint: <LOTVUE_PUBLIC_URL>/api/stripe/webhook
# Events: checkout.session.completed, invoice.paid, invoice.payment_failed,
#         customer.subscription.updated, customer.subscription.deleted
# Receipts: Stripe Dashboard -> Settings -> Customer emails -> "Successful payments".
# Card updates/cancel: Settings -> Billing -> Customer portal -> activate.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Bounded resource defaults (values are clamped by the application).
LOTVUE_MAX_VIDEO_MB=500
LOTVUE_MAX_PHOTO_MB=30
LOTVUE_MAX_PHOTO_BATCH_MB=400
LOTVUE_MAX_CONCURRENT_UPLOADS=2
LOTVUE_MAX_IMAGE_PIXELS=40000000
LOTVUE_BACKGROUND_WORKERS=2
LOTVUE_BACKGROUND_MAX_JOBS=4
LOTVUE_STUDIO_MAX_PHOTOS=72
LOTVUE_PHOTO_MAX_EDGE=1920
LOTVUE_BACKGROUND_MAX_PHOTOS=20
LOTVUE_BACKGROUND_MAX_EDGE=1920
LOTVUE_MAX_IMPORT_PHOTOS=100
LOTVUE_MAX_IMPORT_IMAGE_PIXELS=16000000

# rembg's Python runtime is optional and separate from model weights. No model is
# selected by default. After the owner verifies a checkpoint's commercial rights,
# set its exact rembg model name and explicitly acknowledge that review.
LOTVUE_REMBG_MODEL=
LOTVUE_REMBG_LICENSE_ACCEPTED=0

# Optional local model service for assisted classification/chat; no browser-side
# localhost calls are made. Leave blank if no local server is intentionally run.
LOTVUE_OLLAMA_URL=
LOTVUE_OLLAMA_MODEL=qwen3.6-64k:latest
LOTVUE_VLM_MODEL=qwen2.5vl:3b

# Optional ComfyUI/WAN/Kokoro stack. These models and compatible GPU toolchains
# are hardware-specific and are not included in the base desktop installer.
COMFYUI_URL=
COMFYUI_PYTHON=
COMFYUI_ROOT=
COMFYUI_MODELS=
COMFYUI_INPUT=
COMFYUI_OUTPUT=
# Optional AI scene replacement: owner-supplied ComfyUI API-format workflow path.
# Use documented __LOTVUE_*__ value tokens; no model/node graph is bundled.
LOTVUE_COMFYUI_SCENE_WORKFLOW=
LOTVUE_COMFYUI_SCENE_TIMEOUT=300
LOTVUE_PYTHON=
LOTVUE_PY_ISOLATED=
COLMAP_PATH=
COLMAP_EXE=
BRUSH_EXE=
WAN_HIGH_NOISE_PATH=
WAN_LOW_NOISE_PATH=
WAN_VAE_PATH=
WAN_TEXT_ENCODER_PATH=
WAN_TOKENIZER_PATH=
WAN_CLIP_VISION_PATH=
KOKORO_MODEL_PATH=
KOKORO_VOICES_PATH=
KOKORO_ONNX_PATH=

# Leave blank to use the bundled FFmpeg/FFprobe binaries; set only to override.
FFMPEG_PATH=
FFPROBE_PATH=
FFMPEG_FONT_BOLD=
FFMPEG_FONT_REGULAR=
LOTVUE_RENDER_MODE=studio
