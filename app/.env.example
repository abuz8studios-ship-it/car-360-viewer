# LotVue360 — copy to app/.env and fill in. Any integration without a credential
# simply stays off; nothing fakes data.

# ── Features ────────────────────────────────────────────────────────────────
# The sign-in gate is ALWAYS on, so AUTH must be 1 or nobody can create an account.
LOTVUE_FEATURE_AUTH=1
LOTVUE_FEATURE_PAYMENTS=0          # 1 = Stripe checkout + paywall after free vehicles
LOTVUE_FEATURE_WATERMARK=0

# ── Public URL (used for Stripe redirect URLs and share links) ─────────────
LOTVUE_PUBLIC_URL=https://lotvue.abuz8ai.com

# ── Pricing — the ONE place the price is set (read by app/billing.py) ──────
LOTVUE_PRICE_MONTHLY_CENTS=9900    # 9900 = $99/month Dealership plan
LOTVUE_FREE_VEHICLES=5             # vehicles a dealer can create before paying

# ── Stripe (Dashboard -> Developers -> API keys / Webhooks) ────────────────
# Webhook endpoint: <LOTVUE_PUBLIC_URL>/api/stripe/webhook
# Events: checkout.session.completed, invoice.paid, invoice.payment_failed,
#         customer.subscription.updated, customer.subscription.deleted
# Receipts: Settings -> Customer emails -> enable "Successful payments".
# Card updates/cancel: Settings -> Billing -> Customer portal -> activate.
STRIPE_SECRET_KEY=sk_live_or_test_here
STRIPE_PUBLISHABLE_KEY=pk_live_or_test_here
STRIPE_WEBHOOK_SECRET=whsec_here

# ── Accounts ───────────────────────────────────────────────────────────────
LOTVUE_JWT_SECRET=                 # long random string; blank = auto-generated app/.jwt_secret
LOTVUE_ADMIN_EMAILS=               # comma-separated; may comp plans via /api/set-plan
# Owner login re-asserted on every boot. Hash with (inside app/):
#   python -c "from passwords import hash_password as h; print(h('your-password'))"
LOTVUE_OWNER_EMAIL=
LOTVUE_OWNER_PASSWORD_HASH=

# ── Privacy ────────────────────────────────────────────────────────────────
LOTVUE_AUTO_PLATE_BLUR=0           # 1 = blur license plates on every finalized spin

# ── Lead alert email (Gmail: use an App Password) ──────────────────────────
LOTVUE_SMTP_HOST=smtp.gmail.com
LOTVUE_SMTP_PORT=587
LOTVUE_SMTP_USER=
LOTVUE_SMTP_PASS=
LOTVUE_SMTP_FROM=
LOTVUE_NOTIFY_EMAIL=
